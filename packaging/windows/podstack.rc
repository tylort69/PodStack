// The icon and file details Windows shows for podstack.exe (Explorer, the taskbar, Properties → Details).
// crates/app/build.rs fills in @VERSION@, @VERSION_COMMAS@ and @ICON@ and compiles a copy.
#include <winver.h>

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "PodStack"
      VALUE "FileDescription", "PodStack"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "podstack"
      VALUE "LegalCopyright", "AGPL-3.0"
      VALUE "OriginalFilename", "podstack.exe"
      VALUE "ProductName", "PodStack"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
